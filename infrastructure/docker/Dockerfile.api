FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY apps/api/ /app/apps/api/
COPY services/ /app/services/

ENV PYTHONPATH=/app/apps/api:/app

# Create non-root system user for production container security
RUN groupadd -r rankforge && useradd -r -g rankforge rankforge && chown -R rankforge:rankforge /app
USER rankforge

EXPOSE 8000

# Production start command: dynamically binds to Railway assigned $PORT, enables multi-worker concurrency and proxy headers
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers ${WEB_CONCURRENCY:-2} --proxy-headers --forwarded-allow-ips='*'"]
