# ==============================================================================
# RANKFORGE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development. Never commit .env to version control.

# Application Environment
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Secrets (Generate strong random secrets in production: openssl rand -hex 32)
SECRET_KEY=rf_dev_secret_key_change_in_production_894172498172938471
API_V1_STR=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# Frontend Next.js Configuration
PORT=3000
NEXT_PUBLIC_APP_NAME="RankForge AI"
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=rankforge
POSTGRES_PASSWORD=rankforge_dev_password
POSTGRES_DB=rankforge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rankforge:rankforge_dev_password@localhost:5432/rankforge_db

# Supabase Compatibility / Phase 2 Auth Integration Preparedness
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis & Celery Worker Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Crawler SSRF Protection Limits
CRAWLER_MAX_RESPONSE_BYTES=5242880 # 5MB limit
CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_MAX_REDIRECTS=3

# AI Engine & Gemini Configuration (Phase 5)
# GEMINI_API_KEY remains backend-only. Never expose to client/browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini
AI_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_DAILY_ORG_REQUEST_LIMIT=100
AI_MONTHLY_ORG_TOKEN_LIMIT=500000
